<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net45;net472</TargetFrameworks>
    <AssemblyName>Sx.Communication</AssemblyName>
    <RootNamespace>Sx.Communication</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <Authors>newboysxb</Authors>
    <Description>TCP communication library for .NET Framework WinForms applications.</Description>
    <PackageTags>tcp;winforms;communication</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
